---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { institutes } from "../../data/institutes";
import { withBase } from "../../lib/url";
---

<BaseLayout
  title="Explore the Three Institutes"
  description="Explore the three institutions that shape the PGDBA academic journey: ISI Kolkata, IIT Kharagpur and IIM Calcutta."
>
  <section class="relative overflow-hidden bg-gradient-to-b from-noir-900 via-noir-900 to-noir-950">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(86,142,174,0.65),_transparent_60%)]"></div>
    <div class="relative mx-auto max-w-4xl px-5 py-16 text-center sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-400">The PGDBA experience</p>
      <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-noir-50 sm:text-6xl">
        Three institutes<span class="text-brand-500">.</span><br />
        Three perspectives<span class="text-brand-500">.</span><br />
        <span class="text-brand-400">One journey.</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-balance text-lg text-noir-200">
        Experience three distinct academic environments, each bringing its own expertise to the world of business analytics.
      </p>
      <a
        href={withBase("/academics/")}
        class="mt-8 inline-flex rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
      >
        Explore the curriculum
      </a>
    </div>
  </section>

  <section class="border-b border-noir-700 bg-noir-950 px-5">
    <img
      src={withBase("/images/3_institute_logo.jpg")}
      alt="The three PGDBA institutions: ISI Kolkata, IIM Calcutta and IIT Kharagpur"
      class="mx-auto max-h-64 w-full max-w-5xl object-contain"
      width="1200"
      height="400"
    />
  </section>

  <section class="mx-auto max-w-5xl px-5 py-14 sm:py-18">
    <div class="grid gap-5 md:grid-cols-3">
      {institutes.map((institute, index) => (
        <article class="rounded-3xl border border-ink-200 bg-white p-6 shadow-sm sm:p-7">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-700">0{index + 1} · {institute.location}</p>
          <h2 class="mt-3 font-display text-2xl font-semibold text-ink-900">{institute.shortName}</h2>
          <p class="mt-2 text-sm font-semibold text-brand-700">{institute.focus}</p>
          <p class="mt-4 leading-relaxed text-ink-700">{institute.introduction}</p>
          <a
            href={withBase(`/institutes/${institute.slug}/`)}
            class="mt-6 inline-flex whitespace-nowrap text-sm font-semibold text-brand-700 hover:text-brand-800"
          >
            Explore {institute.shortName} <span aria-hidden="true" class="ml-1">→</span>
          </a>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>
