---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LineTrendChart from "../../components/LineTrendChart.astro";
import { finalPlacements, internships, placementSource } from "../../data/placements";
---

<BaseLayout
  title="Placements & Internships"
  description="Explore PGDBA final placement and internship statistics by batch."
>
  <section class="relative overflow-hidden bg-gradient-to-b from-noir-900 via-noir-900 to-noir-950">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(86,142,174,0.65),_transparent_60%)]"></div>
    <div class="relative mx-auto max-w-4xl px-5 py-16 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-400">PGDBA career outcomes</p>
      <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-noir-50 sm:text-5xl">
        Placements & internships<span class="text-brand-500">.</span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-noir-200">
        Compare reported final placement salaries and internship stipends across recent batches.
      </p>
    </div>
  </section>

  <main class="mx-auto max-w-6xl space-y-8 px-5 py-10 sm:py-14">
    <section aria-labelledby="final-placement-heading" class="space-y-5">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-700">Career outcomes</p>
        <h2 id="final-placement-heading" class="mt-1 font-display text-2xl font-semibold text-ink-900 sm:text-3xl">Final Placements</h2>
        <p class="mt-2 text-sm text-ink-600">Salary figures are in lakh per annum.</p>
      </div>

      <LineTrendChart
        data={finalPlacements.map((row) => ({
          year: row.year,
          batch: row.batch,
          max: row.maxSalary,
          mean: row.meanSalary,
          median: row.medianSalary,
        }))}
        title="Salary trends by batch"
        unit="₹ lakh per annum"
        description="Maximum, mean, and median reported final placement salaries"
      />

      <div class="overflow-x-auto rounded-3xl border border-ink-200 bg-white shadow-sm">
        <table class="w-full min-w-[700px] border-collapse text-left text-sm">
          <caption class="px-5 pb-2 pt-5 text-left font-display text-lg font-semibold text-ink-900">
            Placement statistics by batch <span class="font-sans text-sm font-normal text-ink-600">(Lakh per annum)</span>
          </caption>
          <thead>
            <tr class="border-b border-ink-200 text-ink-600">
              <th scope="col" class="px-5 py-3 font-semibold">Year</th>
              <th scope="col" class="px-3 py-3 font-semibold">Batch</th>
              <th scope="col" class="px-3 py-3 font-semibold">Batch size</th>
              <th scope="col" class="px-3 py-3 font-semibold">No. of offers</th>
              <th scope="col" class="px-3 py-3 font-semibold">Max</th>
              <th scope="col" class="px-3 py-3 font-semibold">Mean</th>
              <th scope="col" class="px-3 py-3 font-semibold">Median</th>
            </tr>
          </thead>
          <tbody>
            {finalPlacements.map((row) => (
              <tr class="border-b border-ink-100 last:border-0">
                <td class="px-5 py-3 text-ink-800">{row.year}</td>
                <td class="px-3 py-3 text-ink-800">{row.batch}</td>
                <td class="px-3 py-3 text-ink-800">{row.batchSize}</td>
                <td class="px-3 py-3 text-ink-800">{row.offers}</td>
                <td class="px-3 py-3 font-semibold text-ink-900">{row.maxSalary}</td>
                <td class="px-3 py-3 font-semibold text-ink-900">{row.meanSalary}</td>
                <td class="px-3 py-3 font-semibold text-ink-900">{row.medianSalary}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="internships-heading" class="space-y-5 pt-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-700">Industry experience</p>
        <h2 id="internships-heading" class="mt-1 font-display text-2xl font-semibold text-ink-900 sm:text-3xl">Internships</h2>
        <p class="mt-2 text-sm text-ink-600">Stipend figures are in lakh per month.</p>
      </div>

      <LineTrendChart
        data={internships.map((row) => ({
          year: row.year,
          batch: row.batch,
          max: row.maxStipend,
          mean: row.meanStipend,
          median: row.medianStipend,
        }))}
        title="Internship stipend trends by batch"
        unit="₹ lakh per month"
        description="Maximum, mean, and median reported internship stipends"
        axisMaximum={4}
        axisTicks={[1, 2, 3, 4]}
      />

      <div class="overflow-x-auto rounded-3xl border border-ink-200 bg-white shadow-sm">
        <table class="w-full min-w-[650px] border-collapse text-left text-sm">
          <caption class="px-5 pb-2 pt-5 text-left font-display text-lg font-semibold text-ink-900">
            Internship statistics by batch <span class="font-sans text-sm font-normal text-ink-600">(Lakh per month)</span>
          </caption>
          <thead>
            <tr class="border-b border-ink-200 text-ink-600">
              <th scope="col" class="px-5 py-3 font-semibold">Year</th>
              <th scope="col" class="px-3 py-3 font-semibold">Batch</th>
              <th scope="col" class="px-3 py-3 font-semibold">Batch size</th>
              <th scope="col" class="px-3 py-3 font-semibold">Max</th>
              <th scope="col" class="px-3 py-3 font-semibold">Mean</th>
              <th scope="col" class="px-3 py-3 font-semibold">Median</th>
            </tr>
          </thead>
          <tbody>
            {internships.map((row) => (
              <tr class="border-b border-ink-100 last:border-0">
                <td class="px-5 py-3 text-ink-800">{row.year}</td>
                <td class="px-3 py-3 text-ink-800">{row.batch}</td>
                <td class="px-3 py-3 text-ink-800">{row.batchSize}</td>
                <td class="px-3 py-3 font-semibold text-ink-900">{row.maxStipend}</td>
                <td class="px-3 py-3 font-semibold text-ink-900">{row.meanStipend}</td>
                <td class="px-3 py-3 font-semibold text-ink-900">{row.medianStipend}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <p class="text-sm leading-relaxed text-ink-600">
      These charts compare published maximum, mean, and median figures; they do not represent individual salary or stipend distributions.
      Source: <a href={placementSource} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-700 hover:text-brand-800">
        PGDBA IIT Kharagpur placements <span aria-hidden="true">↗</span>
      </a>
    </p>
  </main>
</BaseLayout>
