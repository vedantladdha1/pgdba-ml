---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/url";

const stages = [
  { number: "01", label: "Apply", href: "#application" },
  { number: "02", label: "Take the test", href: "#admission-test" },
  { number: "03", label: "Attend the PI", href: "#personal-interview" },
  { number: "04", label: "Final selection", href: "#final-selection" },
  { number: "05", label: "Confirm admission", href: "#admission-confirmation" },
];
---

<BaseLayout
  title="PGDBA Admission Process"
  description="A step-by-step guide to the PGDBA application, admission test, personal interview, selection and admission process."
>
  <section class="relative overflow-hidden bg-gradient-to-b from-noir-900 via-noir-900 to-noir-950">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(86,142,174,0.65),_transparent_60%)]"></div>
    <div class="relative mx-auto max-w-4xl px-5 py-16 text-center sm:py-20">
      <p class="light-theme-highlight text-sm font-semibold uppercase tracking-[0.18em] text-brand-400">Admissions guide</p>
      <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-noir-50 sm:text-5xl">
        From application to admission<span class="text-brand-500">.</span>
      </h1>
      <p class="mx-auto mt-5 max-w-3xl text-lg leading-relaxed text-noir-200">
        Understand the steps in the PGDBA selection journey, what each stage involves, and where to find the official information for your admission cycle.
      </p>
      <a
        href={withBase("/eligibility/")}
        class="light-theme-solid-pill mt-7 inline-flex rounded-full bg-brand-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
      >
        Check eligibility <span aria-hidden="true" class="ml-2">→</span>
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-8 sm:py-12" aria-label="Admission process at a glance">
    <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {stages.map((stage) => (
        <li>
          <a
            href={stage.href}
            class="floating-card card-interactive process-step-card group flex h-full items-center gap-3 rounded-2xl border border-ink-200 bg-white p-4 transition-colors hover:border-brand-300"
          >
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-semibold text-white">{stage.number}</span>
            <span class="font-semibold text-ink-800 group-hover:text-brand-800">{stage.label}</span>
            <span class="ml-auto text-brand-700" aria-hidden="true">↓</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="mx-auto max-w-4xl px-5 pb-12 sm:pb-16">
    <aside class="info-callout mb-8 rounded-2xl border border-brand-200 p-5 text-ink-800" role="note">
      <p class="font-semibold text-brand-800">Cycle-specific information</p>
      <p class="mt-1 leading-relaxed">
        The test pattern, dates, eligibility rules, shortlisting adjustments, and score weights described here refer to the 2026–28 admission cycle, based on the information supplied for this guide. They may change for future cycles. Always confirm current requirements with the official admission notification; it takes precedence over this site.
      </p>
    </aside>

    <div class="space-y-6">
      <article id="application" class="floating-card process-detail-card scroll-mt-24 rounded-3xl border border-ink-200 bg-white p-6 shadow-sm sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">Stage 01</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink-900 sm:text-3xl">Online application</h2>
        <p class="mt-4 leading-relaxed text-ink-700">
          Register through the official PGDBA admission portal, complete the application form, upload the requested documents, and pay the application fee before the published deadline.
        </p>
        <p class="mt-3 leading-relaxed text-ink-700">
          The form may ask for personal and contact details, category information, academic history, work experience, examination and interview city preferences, extracurricular activities, and career goals. Review every field and uploaded document before submitting.
        </p>
        <a href={withBase("/eligibility/")} class="mt-4 inline-flex font-semibold text-brand-700 hover:text-brand-800">
          Review eligibility requirements <span aria-hidden="true" class="ml-2">→</span>
        </a>
      </article>

      <article id="admission-test" class="floating-card process-detail-card scroll-mt-24 rounded-3xl border border-ink-200 bg-white p-6 shadow-sm sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">Stage 02</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink-900 sm:text-3xl">Admit card and PGDBA Admission Test</h2>
        <p class="mt-4 leading-relaxed text-ink-700">
          Download the admit card from the official portal and follow the instructions for the test centre, reporting time, identity proof, and examination day. The 2026 test details supplied for this guide describe a computer-based, three-hour examination.
        </p>

        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
          {[
            { value: "150", label: "maximum marks" },
            { value: "50", label: "questions" },
            { value: "180 min", label: "duration" },
            { value: "+3 / −1", label: "correct / incorrect" },
          ].map((stat) => (
            <div class="metric-card rounded-2xl bg-brand-50 p-4 text-center">
              <p class="font-display text-xl font-semibold text-brand-800">{stat.value}</p>
              <p class="mt-1 text-xs font-medium text-ink-600">{stat.label}</p>
            </div>
          ))}
        </div>

        <h3 class="mt-7 font-semibold text-ink-900">Section distribution in the 2026 test</h3>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          <li class="rounded-xl border border-ink-100 px-4 py-3 text-sm text-ink-700"><strong>Quantitative Aptitude</strong> · 25 questions</li>
          <li class="rounded-xl border border-ink-100 px-4 py-3 text-sm text-ink-700"><strong>Verbal Ability</strong> · 15 questions</li>
          <li class="rounded-xl border border-ink-100 px-4 py-3 text-sm text-ink-700"><strong>Logical Reasoning</strong> · 5 questions</li>
          <li class="rounded-xl border border-ink-100 px-4 py-3 text-sm text-ink-700"><strong>Data Interpretation &amp; Visualization</strong> · 5 questions</li>
        </ul>

        <details class="group mt-5 rounded-2xl border border-ink-200 p-4">
          <summary class="cursor-pointer font-semibold text-brand-800">View the 2026 test syllabus overview</summary>
          <div class="mt-4 grid gap-4 text-sm leading-relaxed text-ink-700">
            <div class="subject-card rounded-xl border border-ink-100 p-4">
              <h4 class="font-semibold text-ink-900">Quantitative Aptitude</h4>
              <p class="mt-1">
                Sets; combinatorics; basic probability theory; algebra, including solutions of quadratic equations, inequalities, simultaneous linear equations, binomial theorem, series, arithmetic, geometric and harmonic progressions (AP, GP, HP), and matrices; Euclidean geometry; coordinate geometry, including lines, circles, and conic sections; trigonometry, including triangles, trigonometric identities, heights, and distances; and calculus, including functions, limits, continuity, derivatives, maxima and minima, methods of integration, and evaluation of areas using integration.
              </p>
            </div>
            <div class="subject-card rounded-xl border border-ink-100 p-4">
              <h4 class="font-semibold text-ink-900">Verbal Ability</h4>
              <p class="mt-1">Reading and comprehension; grammar and correction of sentences.</p>
            </div>
            <div class="subject-card rounded-xl border border-ink-100 p-4">
              <h4 class="font-semibold text-ink-900">Logical Reasoning</h4>
              <p class="mt-1">Logical connectives; statements and conclusions; matching; and related topics.</p>
            </div>
            <div class="subject-card rounded-xl border border-ink-100 p-4">
              <h4 class="font-semibold text-ink-900">Data Interpretation &amp; Visualization</h4>
              <p class="mt-1">Data-driven questions, for example, interpreting charts, graphs, and tables.</p>
            </div>
          </div>
          <p class="mt-4 text-xs leading-relaxed text-ink-500">The examination pattern and syllabus can change; consult the official notification for the cycle you are applying to.</p>
        </details>
      </article>

      <article id="answer-key-results" class="floating-card process-detail-card scroll-mt-24 rounded-3xl border border-ink-200 bg-white p-6 shadow-sm sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">Stage 03</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink-900 sm:text-3xl">Answer key, results, and PI shortlisting</h2>
        <p class="mt-4 leading-relaxed text-ink-700">
          After the test, the admission authority may publish a provisional answer key and provide a time-limited process for raising objections. The result is announced through the official portal; candidates should follow its instructions and check their registered communication channels.
        </p>
        <p class="mt-3 leading-relaxed text-ink-700">
          Personal Interview shortlisting is based on the admission test score. For the 2026–28 cycle, the supplied criteria specify an additional 2 marks for women and transgender candidates for PI shortlisting only; those marks are not included in the final selection score.
        </p>
        <p class="info-callout mt-3 rounded-xl p-4 text-sm leading-relaxed text-ink-800">
          A test result or PI call does not guarantee admission. Shortlisting and final selection are separate stages with their own criteria.
        </p>
      </article>

      <article id="personal-interview" class="floating-card process-detail-card scroll-mt-24 rounded-3xl border border-ink-200 bg-white p-6 shadow-sm sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">Stage 04</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink-900 sm:text-3xl">Personal Interview</h2>
        <p class="mt-4 leading-relaxed text-ink-700">
          Shortlisted applicants attend a Personal Interview according to the schedule and instructions shared by the admission authority. The discussion may draw on a candidate’s academic background, analytical and quantitative fundamentals, projects, work experience, general awareness, communication, and motivation for pursuing PGDBA.
        </p>
        <p class="mt-3 leading-relaxed text-ink-700">
          Interview questions and panel approach can vary. Prepare to explain your own experiences and reasoning clearly rather than relying on a fixed list of questions.
        </p>
        <a href={withBase("/experiences/")} class="mt-4 inline-flex font-semibold text-brand-700 hover:text-brand-800">
          Read student interview experiences <span aria-hidden="true" class="ml-2">→</span>
        </a>
      </article>

      <article id="final-selection" class="floating-card process-detail-card scroll-mt-24 rounded-3xl border border-ink-200 bg-white p-6 shadow-sm sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">Stage 05</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink-900 sm:text-3xl">Final score and merit list</h2>
        <p class="mt-4 leading-relaxed text-ink-700">
          For the 2026–28 cycle, the supplied final selection criteria assign 45 marks to the admission test, 40 to the Personal Interview, 8 to Class XII performance, and 7 to work experience. The gender diversity marks for PI shortlisting are not part of this final score.
        </p>

        <div class="mt-5 overflow-x-auto rounded-2xl border border-ink-200">
          <table class="w-full min-w-[22rem] text-left text-sm">
            <caption class="sr-only">2026–28 PGDBA final selection score components</caption>
            <thead class="bg-brand-50 text-ink-800">
              <tr><th scope="col" class="px-4 py-3 font-semibold">Component</th><th scope="col" class="px-4 py-3 text-right font-semibold">Marks</th></tr>
            </thead>
            <tbody class="divide-y divide-ink-100 text-ink-700">
              <tr><th scope="row" class="px-4 py-3 font-medium">PGDBA Admission Test</th><td class="px-4 py-3 text-right">45</td></tr>
              <tr><th scope="row" class="px-4 py-3 font-medium">Personal Interview</th><td class="px-4 py-3 text-right">40</td></tr>
              <tr><th scope="row" class="px-4 py-3 font-medium">Class XII marks</th><td class="px-4 py-3 text-right">8</td></tr>
              <tr><th scope="row" class="px-4 py-3 font-medium">Work experience</th><td class="px-4 py-3 text-right">7</td></tr>
              <tr class="bg-brand-50 font-semibold text-ink-900"><th scope="row" class="px-4 py-3">Total</th><td class="px-4 py-3 text-right">100</td></tr>
            </tbody>
          </table>
        </div>

        <details class="group mt-5 rounded-2xl border border-ink-200 p-4">
          <summary class="cursor-pointer font-semibold text-brand-800">View the supplied Class XII and work-experience scoring bands</summary>
          <div class="mt-4 grid gap-5 md:grid-cols-2">
            <div class="overflow-x-auto">
              <h3 class="mb-2 font-semibold text-ink-900">Class XII percentage</h3>
              <table class="w-full text-left text-sm">
                <thead class="bg-brand-50 text-ink-800"><tr><th class="px-3 py-2">Percentage</th><th class="px-3 py-2 text-right">Points</th></tr></thead>
                <tbody class="divide-y divide-ink-100 text-ink-700">
                  <tr><td class="px-3 py-2">Above 95%</td><td class="px-3 py-2 text-right">8</td></tr>
                  <tr><td class="px-3 py-2">90–95%</td><td class="px-3 py-2 text-right">7</td></tr>
                  <tr><td class="px-3 py-2">85–90%</td><td class="px-3 py-2 text-right">6</td></tr>
                  <tr><td class="px-3 py-2">80–85%</td><td class="px-3 py-2 text-right">5</td></tr>
                  <tr><td class="px-3 py-2">75–80%</td><td class="px-3 py-2 text-right">4</td></tr>
                  <tr><td class="px-3 py-2">70–75%</td><td class="px-3 py-2 text-right">3</td></tr>
                  <tr><td class="px-3 py-2">65–70%</td><td class="px-3 py-2 text-right">2</td></tr>
                  <tr><td class="px-3 py-2">60–65%</td><td class="px-3 py-2 text-right">1</td></tr>
                  <tr><td class="px-3 py-2">Below 60%</td><td class="px-3 py-2 text-right">0</td></tr>
                </tbody>
              </table>
            </div>
            <div class="overflow-x-auto">
              <h3 class="mb-2 font-semibold text-ink-900">Completed full-time work experience</h3>
              <table class="w-full text-left text-sm">
                <thead class="bg-brand-50 text-ink-800"><tr><th class="px-3 py-2">Months</th><th class="px-3 py-2 text-right">Points</th></tr></thead>
                <tbody class="divide-y divide-ink-100 text-ink-700">
                  <tr><td class="px-3 py-2">0</td><td class="px-3 py-2 text-right">0</td></tr>
                  <tr><td class="px-3 py-2">More than 0 to 6</td><td class="px-3 py-2 text-right">1</td></tr>
                  <tr><td class="px-3 py-2">More than 6 to 12</td><td class="px-3 py-2 text-right">3</td></tr>
                  <tr><td class="px-3 py-2">More than 12 to 24</td><td class="px-3 py-2 text-right">5</td></tr>
                  <tr><td class="px-3 py-2">More than 24 to 36</td><td class="px-3 py-2 text-right">7</td></tr>
                  <tr><td class="px-3 py-2">More than 36 to 48</td><td class="px-3 py-2 text-right">6</td></tr>
                  <tr><td class="px-3 py-2">More than 48 to 60</td><td class="px-3 py-2 text-right">5</td></tr>
                  <tr><td class="px-3 py-2">More than 60</td><td class="px-3 py-2 text-right">4</td></tr>
                </tbody>
              </table>
            </div>
          </div>
          <p class="mt-4 text-xs leading-relaxed text-ink-500">
            The supplied 2026–28 criteria count qualifying full-time work after the qualifying degree and specify exclusions such as internships, training, curricular projects, and unpaid work. The official brochure defines the applicable calculation date, equivalence rules, and exclusions.
          </p>
        </details>

        <p class="mt-5 leading-relaxed text-ink-700">
          Final results are published as a merit list subject to the applicable selection rules, reservation provisions, eligibility checks, and document verification. An entrance test result or PI call alone does not assure a final offer.
        </p>
      </article>

      <article id="admission-confirmation" class="floating-card process-detail-card scroll-mt-24 rounded-3xl border border-ink-200 bg-white p-6 shadow-sm sm:p-8">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-700">After selection</p>
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink-900 sm:text-3xl">Offer confirmation and joining</h2>
        <p class="mt-4 leading-relaxed text-ink-700">
          Selected candidates must accept the offer, pay the required fees, and complete document verification and other joining formalities by the deadlines communicated by the admission authority. After admission, students begin the two-year, full-time residential programme across IIM Calcutta, ISI Kolkata, and IIT Kharagpur, which includes an industry internship.
        </p>
      </article>
    </div>
  </section>

  <section class="bg-noir-950 px-5 py-12 sm:py-14">
    <div class="mx-auto max-w-4xl">
      <h2 class="font-display text-2xl font-semibold text-noir-50 sm:text-3xl">Official information</h2>
      <p class="mt-3 leading-relaxed text-noir-200">
        Confirm the admission authority, deadlines, eligibility, exam pattern, and scoring rules for the batch you are applying to. Official notices can change between cycles.
      </p>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        <li><a class="light-theme-solid-pill inline-flex rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700" href="https://www.isical.ac.in/~pgdba/" target="_blank" rel="noreferrer">Official PGDBA admission portal ↗</a></li>
        <li><a class="inline-flex rounded-full border border-noir-700 px-4 py-2 text-sm font-semibold text-noir-50 hover:border-brand-400" href="https://www.iimcal.ac.in/programs/pgdba/admission" target="_blank" rel="noreferrer">IIM Calcutta admissions information ↗</a></li>
        <li><a class="inline-flex rounded-full border border-noir-700 px-4 py-2 text-sm font-semibold text-noir-50 hover:border-brand-400" href="https://www.isical.ac.in/~pgdba/Eligibility_Selection_Criteria.html" target="_blank" rel="noreferrer">Eligibility and selection criteria ↗</a></li>
        <li><a class="inline-flex rounded-full border border-noir-700 px-4 py-2 text-sm font-semibold text-noir-50 hover:border-brand-400" href="https://www.isical.ac.in/~pgdba/How_To_Apply.html" target="_blank" rel="noreferrer">Application instructions ↗</a></li>
        <li><a class="inline-flex rounded-full border border-noir-700 px-4 py-2 text-sm font-semibold text-noir-50 hover:border-brand-400" href="https://www.isical.ac.in/~pgdba/Sample_Questions.html" target="_blank" rel="noreferrer">Syllabus and sample questions ↗</a></li>
        <li><a class="inline-flex rounded-full border border-noir-700 px-4 py-2 text-sm font-semibold text-noir-50 hover:border-brand-400" href="https://www.isical.ac.in/~pgdba/Important_Dates.html" target="_blank" rel="noreferrer">Important dates ↗</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
