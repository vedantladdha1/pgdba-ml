---
import BaseLayout from "../../layouts/BaseLayout.astro";

const faqs = [
  {
    question: "What is PGDBA?",
    answer:
      "The Post Graduate Diploma in Business Analytics (PGDBA) is a two-year, full-time residential programme jointly offered by ISI Kolkata, IIT Kharagpur and IIM Calcutta.",
  },
  {
    question: "Who should pursue PGDBA?",
    answer:
      "PGDBA is designed for individuals with an analytical mindset, an inclination towards mathematics, machine learning and an interest in solving complex business problems using data.",
  },
  {
    question: "What makes PGDBA unique?",
    answer:
      "PGDBA combines the expertise of three premier institutions: ISI's strength in statistics and machine learning, IIT Kharagpur's expertise in technology, and IIM Calcutta's focus on business and management applications.",
  },
  {
    question: "How is the programme structured across the three institutes?",
    answer:
      "Students study at all three institutions, spending approximately six months at each. The academic curriculum is followed by a six-month industry internship involving a hands-on analytics project.",
  },
  {
    question: "What career opportunities are available after PGDBA?",
    answer:
      "Graduates can pursue careers in AI, business analytics, data science, consulting, finance and other data-driven domains. Students have access to placement facilities supported by all three participating institutes.",
  },
];
---

<BaseLayout
  title="Frequently Asked Questions"
  description="Answers to common questions about the PGDBA programme, its structure, and career opportunities."
>
  <section class="relative overflow-hidden bg-gradient-to-b from-noir-900 via-noir-900 to-noir-950">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(86,142,174,0.65),_transparent_60%)]"></div>
    <div class="relative mx-auto max-w-3xl px-5 py-16 text-center sm:py-20">
      <h1 class="font-display text-4xl font-semibold tracking-tight text-noir-50 sm:text-5xl">
        Frequently asked <span class="text-brand-400">questions</span><span class="text-brand-500">.</span>
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-noir-200">
        Learn about the PGDBA programme, the three institutes, and where it can take you.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-12 sm:py-16" aria-label="Frequently asked questions">
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group rounded-2xl border border-ink-200 bg-white p-5 shadow-sm sm:p-6">
          <summary class="cursor-pointer font-display text-lg font-semibold text-ink-900 marker:text-brand-600 sm:text-xl">
            <span class="mr-2 text-brand-600">{index + 1}.</span>
            {faq.question}
          </summary>
          <p class="mt-4 border-t border-ink-100 pt-4 leading-relaxed text-ink-700">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
