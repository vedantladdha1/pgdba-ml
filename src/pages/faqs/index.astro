---
import BaseLayout from "../../layouts/BaseLayout.astro";

const faqs = [
  {
    question: "What is PGDBA?",
    answer:
      "The Post Graduate Diploma in Business Analytics (PGDBA) is a two-year, full-time programme jointly offered by IIM Calcutta, the Indian Statistical Institute (ISI), and IIT Kharagpur. It develops the analytical and managerial skills needed to solve complex business problems.",
  },
  {
    question: "For whom is PGDBA suitable?",
    answer:
      "PGDBA is designed for people with an analytical mindset, an inclination towards mathematics, and an interest in solving challenging business problems using data. The programme combines learning across three institutes with hands-on analytics training and industry exposure.",
  },
  {
    question: "What would I learn at the three institutes?",
    answer:
      "Students spend time at all three institutions, each focusing on its area of expertise. ISI Kolkata teaches statistical and machine-learning foundations, IIT Kharagpur focuses on technology, and IIM Calcutta covers analytics applications in management.",
  },
  {
    question: "What is the duration of the programme?",
    answer:
      "PGDBA is a two-year, full-time programme.",
  },
  {
    question: "Is the programme residential?",
    answer:
      "The programme is residential. Students stay on the campuses of the participating institutes during the academic phases hosted there.",
  },
  {
    question: "Is there an internship as part of the programme?",
    answer:
      "Yes. Students complete a six-month, internship-based project at a business organisation, applying business analytics to real-world industry problems.",
  },
  {
    question: "Who awards the PGDBA diploma?",
    answer:
      "The Post Graduate Diploma in Business Analytics is awarded jointly by IIM Calcutta, ISI, and IIT Kharagpur after students complete the programme requirements.",
  },
  {
    question: "What are the attendance requirements?",
    answer:
      "Students follow the attendance rules of the institute hosting their semester. The applicable institute's policy governs attendance during that period.",
  },
  {
    question: "How are pass and fail rules determined?",
    answer:
      "The academic regulations of the institute hosting each semester determine its pass and fail requirements.",
  },
  {
    question: "Can PGDBA students join clubs and student activities?",
    answer:
      "Yes. Students can participate in PGDBA student teams and, subject to each institute's processes, clubs and teams at the three campuses.",
  },
];
---

<BaseLayout
  title="Frequently Asked Questions"
  description="Answers to common questions about the PGDBA programme, its structure, and career opportunities."
>
  <section class="relative overflow-hidden bg-gradient-to-b from-noir-900 via-noir-900 to-noir-950">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(86,142,174,0.65),_transparent_60%)]"></div>
    <div class="relative mx-auto max-w-3xl px-5 py-16 text-center sm:py-20">
      <h1 class="font-display text-4xl font-semibold tracking-tight text-noir-50 sm:text-5xl">
        Frequently asked <span class="light-theme-highlight text-brand-400">questions</span><span class="text-brand-500">.</span>
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-noir-200">
        Learn about the PGDBA programme, the three institutes, and where it can take you.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-12 sm:py-16" aria-label="Frequently asked questions">
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="floating-card group rounded-2xl border border-ink-200 bg-white p-5 shadow-sm sm:p-6">
          <summary class="cursor-pointer font-display text-lg font-semibold text-ink-900 marker:text-brand-600 sm:text-xl">
            <span class="mr-2 text-brand-600">{index + 1}.</span>
            {faq.question}
          </summary>
          <p class="mt-4 border-t border-ink-100 pt-4 leading-relaxed text-ink-700">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
