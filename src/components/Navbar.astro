---
import { withBase } from "../lib/url";

const navItems = [
  { href: withBase("/"), label: "About" },
  { href: withBase("/academics/"), label: "Academics" },
  { href: withBase("/institutes/"), label: "Institutes" },
  { href: withBase("/placements/"), label: "Placements & Internships" },
  { href: withBase("/eligibility/"), label: "Eligibility" },
  { href: withBase("/experiences/"), label: "Interview experiences" },
  { href: withBase("/clubs/"), label: "Teams" },
  { href: withBase("/faqs/"), label: "FAQs" },
  { href: withBase("/connect/"), label: "Connect" },
];
const currentPath = Astro.url.pathname;
const homeHref = withBase("/");

function isActive(href: string) {
  if (href === homeHref) return currentPath === homeHref;
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-noir-700 bg-noir-900/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3">
    <a href={homeHref} class="flex items-center gap-3">
      <img src={withBase("/images/logo.png")} alt="PGDBA logo" class="h-10 w-10" width="40" height="40" />
      <span class="font-display text-lg font-semibold tracking-tight text-noir-50">PGDBA</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="peer hidden" />

    <nav
      class="absolute left-0 right-0 top-full hidden flex-col gap-1 border-b border-noir-700 bg-noir-900 px-5 py-3 peer-checked:flex xl:static xl:flex xl:flex-row xl:items-center xl:gap-1 xl:border-none xl:bg-transparent xl:p-0"
    >
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "whitespace-nowrap rounded-md px-2 py-2 text-sm font-medium transition-colors",
            isActive(item.href)
              ? "bg-brand-600/15 text-brand-400"
              : "text-noir-200 hover:bg-noir-800 hover:text-noir-50",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1">
      <button
        id="theme-toggle"
        type="button"
        class="cursor-pointer rounded-md p-2 text-noir-200 hover:bg-noir-800 hover:text-noir-50"
        aria-label="Toggle dark mode"
        aria-pressed="false"
      >
        <svg class="theme-icon-moon h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
        </svg>
        <svg class="theme-icon-sun h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.36 6.36l-.7-.7M6.34 6.34l-.7-.7m12.02 0l-.7.7M6.34 17.66l-.7.7M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </button>

      <label
        for="nav-toggle"
        class="cursor-pointer rounded-md p-2 text-noir-200 hover:bg-noir-800 hover:text-noir-50 xl:hidden"
        aria-label="Toggle menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
    </div>
  </div>
</header>

<style>
  .theme-icon-sun {
    display: none;
  }
  :global(html.dark) .theme-icon-moon {
    display: none;
  }
  :global(html.dark) .theme-icon-sun {
    display: block;
  }
</style>

<script>
  const themeToggle = document.getElementById("theme-toggle");

  function applyTheme(theme: "light" | "dark") {
    const isDark = theme === "dark";
    document.documentElement.classList.toggle("dark", isDark);
    themeToggle?.setAttribute("aria-label", `Switch to ${isDark ? "light" : "dark"} mode`);
    themeToggle?.setAttribute("aria-pressed", String(isDark));
    themeToggle?.setAttribute("title", `Switch to ${isDark ? "light" : "dark"} mode`);
  }

  applyTheme(document.documentElement.classList.contains("dark") ? "dark" : "light");

  themeToggle?.addEventListener("click", () => {
    const nextTheme = document.documentElement.classList.contains("dark") ? "light" : "dark";
    applyTheme(nextTheme);
    try {
      localStorage.setItem("pgdba-theme", nextTheme);
    } catch {
      // Theme still changes for this page when storage is unavailable.
    }
  });

  window.addEventListener("storage", (event) => {
    if (event.key === "pgdba-theme" && (event.newValue === "light" || event.newValue === "dark")) {
      applyTheme(event.newValue);
    }
  });
</script>
