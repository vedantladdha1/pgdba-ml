---
import type { InterviewRecord } from "../lib/schema";

interface Props {
  record: InterviewRecord;
}
const { record: r } = Astro.props;

const quickFacts = [r.ugCollege, r.gradStream].filter(Boolean);
const workExDomain = r.workExBackground?.trim() || "Not specified";

const questionSections: Array<{ label: string; value?: string }> = [
  { label: "Work-ex / profile questions", value: r.questions.general },
  { label: "Maths & statistics questions", value: r.questions.mathStats },
  { label: "Coding / ML questions", value: r.questions.coding },
  { label: "GK & current affairs questions", value: r.questions.gk },
  { label: "Logical reasoning / puzzles", value: r.questions.logical },
].filter((s) => s.value);

const infoGrid: Array<{ label: string; value?: string }> = [
  { label: "Undergraduate college", value: r.ugCollege },
  { label: "Background", value: r.ugBackground },
  { label: "Graduation year", value: r.gradYear },
  { label: "Stream", value: r.gradStream },
  { label: "Master's degree", value: r.mastersDegree },
  { label: "Post-graduation", value: [r.pgCollege, r.pgStream].filter(Boolean).join(", ") || undefined },
  { label: "Work experience", value: [r.workExMonths, r.workExBackground].filter(Boolean).join(" · ") || undefined },
  { label: "Organizations", value: r.organizations },
  { label: "Prior coding experience", value: r.priorCoding },
  { label: "Resources - written exam", value: r.resourcesWritten },
  { label: "Resources - interview", value: r.resourcesInterview },
  { label: "Other Converts", value: r.alternatePrograms },
  { label: "Offers received", value: r.offers },
].filter((f) => f.value);
---

<article class="floating-card flex h-full flex-col rounded-3xl border border-ink-100 bg-white shadow-sm">
  <div class="flex flex-1 flex-col items-start gap-3 p-5">
    <div>
      <h3 class="font-display text-lg font-semibold text-ink-900">{r.name}</h3>
      {quickFacts.length > 0 && (
        <p class="mt-1 text-sm text-ink-500">{quickFacts.join(" · ")}</p>
      )}
      <div class="mt-3 flex flex-wrap gap-2">
        {r.writtenScore !== undefined && (
          <span class="light-theme-solid-pill rounded-full bg-tint-blue px-3 py-1 text-xs font-semibold text-ink-800">
            Written: {r.writtenScore}
          </span>
        )}
        {r.preInterviewScore !== undefined && (
          <span class="light-theme-solid-pill rounded-full bg-tint-blue px-3 py-1 text-xs font-semibold text-ink-800">
            Pre-interview: {r.preInterviewScore}
          </span>
        )}
        <span class="light-theme-solid-pill rounded-full bg-ink-100 px-3 py-1 text-xs font-semibold text-ink-700">
          Work Ex. Domain: {workExDomain}
        </span>
        {r.interviewDifficulty !== undefined && (
          <span class="light-theme-solid-pill rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">
            Difficulty: {r.interviewDifficulty}/5
          </span>
        )}
        {r.batch === "2026-28" && r.linkUrl && (
          <a
            href={r.linkUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="light-theme-solid-pill inline-flex items-center gap-1 rounded-full bg-brand-600 px-3 py-1 text-xs font-semibold text-white hover:bg-brand-700"
          >
            View Profile <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
      {r.linkUrl && r.batch !== "2026-28" && (
        <a
          href={r.linkUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="light-theme-solid-pill mt-2 inline-flex items-center gap-1 rounded-full bg-brand-600 px-3 py-1 text-xs font-semibold text-white hover:bg-brand-700"
        >
          View Profile ↗
        </a>
      )}
    </div>
  </div>

  {(infoGrid.length > 0 || questionSections.length > 0 || r.tips) && (
    <>
      <button
        type="button"
        data-open-experience
        aria-haspopup="dialog"
        class="mt-auto flex w-full items-center justify-between border-t border-ink-100 px-5 py-3 text-left text-sm font-semibold text-brand-700 hover:bg-brand-50/60"
      >
        Read full experience <span aria-hidden="true">↗</span>
      </button>
      <dialog
        data-experience-dialog
        aria-label={`Full interview experience for ${r.name}`}
        class="light-theme-experience-dialog m-auto max-h-[85vh] w-[calc(100%-2rem)] max-w-3xl overflow-y-auto rounded-3xl border border-ink-200 bg-white p-0 text-left text-ink-900 shadow-2xl"
      >
        <div class="light-theme-experience-dialog-header sticky top-0 z-10 flex items-center justify-between gap-4 border-b border-ink-100 bg-white px-5 py-4 sm:px-7">
          <h2 class="font-display text-xl font-semibold text-ink-900">{r.name} · Full experience</h2>
          <form method="dialog">
            <button type="submit" class="rounded-full border border-ink-200 px-4 py-2 text-sm font-semibold text-ink-700 hover:bg-ink-50">
              Close
            </button>
          </form>
        </div>
        <div class="space-y-5 px-5 py-5 sm:px-7 sm:py-6">
        {infoGrid.length > 0 && (
          <dl class="grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
            {infoGrid.map((f) => (
              <div>
                <dt class="text-xs font-medium uppercase tracking-wide text-ink-500">{f.label}</dt>
                <dd class="mt-0.5 whitespace-pre-line text-sm text-ink-800">{f.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {questionSections.length > 0 && (
          <div class="space-y-4 border-t border-ink-100 pt-4">
            {questionSections.map((s) => (
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wide text-brand-700">{s.label}</h4>
                <p class="mt-1 whitespace-pre-line text-sm leading-relaxed text-ink-800">{s.value}</p>
              </div>
            ))}
          </div>
        )}

        {r.tips && (
          <div class="rounded-xl bg-brand-50 p-4">
            <h4 class="text-xs font-semibold uppercase tracking-wide text-brand-700">Tips for aspirants</h4>
            <p class="mt-1 whitespace-pre-line text-sm leading-relaxed text-ink-800">{r.tips}</p>
          </div>
        )}
        </div>
      </dialog>
    </>
  )}
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-open-experience]").forEach((button) => {
    button.addEventListener("click", () => {
      button.closest("article")?.querySelector<HTMLDialogElement>("[data-experience-dialog]")?.showModal();
    });
  });
</script>

<style>
  dialog[data-experience-dialog]::backdrop {
    background: rgb(0 0 0 / 65%);
    backdrop-filter: blur(2px);
  }
</style>
