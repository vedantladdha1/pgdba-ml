---
interface Datum {
  year: number;
  batch: string;
  max: number;
  mean: number;
  median: number;
}

interface Props {
  data: readonly Datum[];
  title: string;
  unit: string;
  description: string;
  axisMaximum?: number;
  axisTicks?: readonly number[];
}

const { data, title, unit, description, axisMaximum, axisTicks } = Astro.props;
const chronologicalData = [...data].sort((a, b) => a.year - b.year);
const width = 760;
const height = 340;
const left = 64;
const right = 28;
const top = 30;
const bottom = 72;
const chartWidth = width - left - right;
const chartHeight = height - top - bottom;
const maxValue = axisMaximum ?? Math.ceil(Math.max(...data.map((row) => row.max)) / 10) * 10;
const tickValues = axisTicks ?? [0, 0.25, 0.5, 0.75, 1].map((fraction) => maxValue * fraction);
const x = (index: number) => left + (chronologicalData.length === 1 ? chartWidth / 2 : (index * chartWidth) / (chronologicalData.length - 1));
const y = (value: number) => top + chartHeight - (value / maxValue) * chartHeight;
const series = [
  { key: "max", label: "Max", color: "var(--chart-max)" },
  { key: "mean", label: "Avg", color: "var(--chart-mean)" },
  { key: "median", label: "Median", color: "var(--chart-median)" },
] as const;
const pathFor = (key: (typeof series)[number]["key"]) =>
  chronologicalData.map((row, index) => `${index === 0 ? "M" : "L"} ${x(index)} ${y(row[key])}`).join(" ");
---

<figure aria-label={`${title}. ${description}`} class="floating-card mx-auto max-w-4xl rounded-3xl border border-ink-200 bg-white p-5 shadow-sm sm:p-8">
  <figcaption class="font-display text-lg font-semibold text-ink-900">{title}</figcaption>
  <p class="mt-1 text-sm text-ink-600">{description} · {unit}</p>
  <div class="mt-5 overflow-x-auto">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label={`${title} line chart, years ${chronologicalData.map((row) => row.year).join(", ")}`}
    class="placement-chart h-auto min-w-[600px] w-full"
    >
      {tickValues.map((tickValue) => {
        const tickY = y(tickValue);
        return (
          <g>
            <line x1={left} y1={tickY} x2={width - right} y2={tickY} stroke="var(--chart-grid)" stroke-width="1" />
            <text x={left - 12} y={tickY + 4} text-anchor="end" fill="var(--chart-muted)" font-size="12">{tickValue}</text>
          </g>
        );
      })}
      <line x1={left} y1={top} x2={left} y2={top + chartHeight} stroke="var(--chart-axis)" stroke-width="1.5" />
      <line x1={left} y1={top + chartHeight} x2={width - right} y2={top + chartHeight} stroke="var(--chart-axis)" stroke-width="1.5" />
      {series.map((metric) => (
        <>
          <path d={pathFor(metric.key)} fill="none" stroke={metric.color} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          {chronologicalData.map((row, index) => (
            <g>
              <circle cx={x(index)} cy={y(row[metric.key])} r="5" fill="white" stroke={metric.color} stroke-width="3" />
              <title>{row.year} {row.batch}: {metric.label} {row[metric.key]} {unit}</title>
            </g>
          ))}
        </>
      ))}
      {chronologicalData.map((row, index) => (
        <text x={x(index)} y={top + chartHeight + 24} text-anchor="middle" fill="var(--chart-label)" font-size="12">
          {row.year}
        </text>
      ))}
      <text x={width / 2} y={height - 12} text-anchor="middle" fill="var(--chart-muted)" font-size="12">Year</text>
    </svg>
  </div>
  <div class="mt-4 flex flex-wrap gap-x-6 gap-y-3 text-base text-ink-700" aria-hidden="true">
    {series.map((metric) => (
      <span class="inline-flex items-center gap-3 font-semibold">
        <span class="h-1.5 w-10 rounded-full" style={`background-color:${metric.color}`}></span>
        {metric.label}
      </span>
    ))}
  </div>
</figure>
